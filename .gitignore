# 6. Large Datasets, Raw Downloads, & Staging Storage
# (Never commit multi-gigabyte research trajectories or temporary DuckDB tables)
data/raw/
data/staging/
*.parquet
*.geoparquet
*.pmtiles
*.duckdb
*.duckdb.tmp
*.tar.gz
*.zip

# Keep sample fixture JSONs and release metadata committed
!data/fixtures/
!data/processed/releases/

# 7. Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

