# LA Mobility Atlas - Environment Configuration Template
# Copy this file to .env or configure your environment variables accordingly.

# ==========================================================
# Cloudflare Workers & Edge Deployment Settings
# ==========================================================
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# ==========================================================
# Cloudflare R2 Object Storage (Parquet & PMTiles)
# ==========================================================
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=la-mobility-atlas-data
R2_PUBLIC_URL=https://data.atlas.la

# ==========================================================
# API & Frontend Configuration
# ==========================================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787/api/v1
NEXT_PUBLIC_DATA_BASE_URL=/data
PORT=3000
HOST=127.0.0.1
